{
  "name": "novelgensuite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "LLM 同士に笑点風の大喜利をさせる TUI アプリ",
  "workspaces": ["packages/*"],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome format --write .",
    "build": "tsc -b",
    "start": "node --import tsx packages/tui/src/main.tsx"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
